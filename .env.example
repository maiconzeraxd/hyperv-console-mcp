# Optional read-time allowlist. Mutations require an explicit allowlist.
HYPERV_MCP_ALLOWED_VMS=NORTH-Test

# Each capability is independently opt-in. Values: true or false.
HYPERV_MCP_ALLOW_POWER=false
HYPERV_MCP_ALLOW_CHECKPOINTS=false
HYPERV_MCP_ALLOW_GUEST=false
HYPERV_MCP_ALLOW_CONSOLE=false
HYPERV_MCP_ALLOW_SCREENSHOTS=false
HYPERV_MCP_ALLOW_DEBUGGER=false

# Required only for PowerShell Direct. Prefer setting these in the MCP host's
# protected environment configuration, not in a committed .env file.
HYPERV_MCP_GUEST_USERNAME=Administrator
HYPERV_MCP_GUEST_PASSWORD=

# HYPERV_MCP_AUDIT_LOG=C:\Path\To\Private\hyperv-mcp-audit.jsonl
HYPERV_MCP_TIMEOUT_SECONDS=90
HYPERV_MCP_MAX_OUTPUT_CHARS=65536
